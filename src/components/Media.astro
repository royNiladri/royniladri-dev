---
/**
 * An image, or the hatched placeholder from the design until the real file is
 * dropped into `public/`. Existence is checked at build time — see
 * `src/lib/assets.ts`.
 */
import { hasAsset } from '~/lib/assets.ts';

interface Props {
  src: string;
  alt: string;
  /** Shown inside the placeholder to say what belongs there. */
  note?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, note, class: className = '', loading = 'lazy' } = Astro.props;
const ready = hasAsset(src);
---

{
  ready ? (
    <img class={`media ${className}`} src={src} alt={alt} loading={loading} />
  ) : (
    <div class={`media placeholder ${className}`} role="img" aria-label={alt}>
      {note && <span class="note">{note}</span>}
    </div>
  )
}

<style>
  .media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 20px;
  }

  .note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
  }
</style>
