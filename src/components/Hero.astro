---
/** Hero photograph with the intro card overlapping it. */
import Media from './Media.astro';
import { profile } from '~/lib/content.ts';

const { current, status } = profile;
---

<section class="hero">
  <div class="shell">
    <div class="photo">
      <Media
        src={profile.heroPhoto}
        alt="Landscape photograph by Niladri Roy"
        note="wide landscape, one of your own photographs"
        loading="eager"
      />
    </div>

    <div class="intro">
      <div class="copy">
        <h1>
          Hi, I'm {profile.name.split(' ')[0]}.
          <em>{profile.headline}</em>
        </h1>
        <p class="lede">{profile.intro}</p>
      </div>

      <div class="now">
        <p class="eyebrow">Right now</p>
        <p class="role">{current.title}</p>
        <p class="org">{current.org} · {current.team} · {current.location}</p>
        <p class="status"><span class="dot"></span>{status}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .photo {
    height: 380px;
    border-radius: var(--r-hero);
    overflow: hidden;
  }

  .intro {
    position: relative;
    margin: -110px 0 0 64px;
    background: var(--card);
    border-radius: var(--r-hero);
    padding: 44px 52px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 56px;
    box-shadow: var(--shadow-card);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  h1 {
    font: 400 50px/1.1 var(--font-serif);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  h1 em {
    font-style: italic;
    color: var(--acc);
  }

  .lede {
    font-size: 18px;
    line-height: 1.65;
    max-width: 58ch;
  }

  .now {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-left: 1px solid var(--line);
    padding-left: 32px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .role {
    font: 600 18px/1.35 var(--font-serif);
  }

  .org {
    font-size: 15px;
    color: var(--mute);
  }

  .status {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--r-btn);
    background: var(--soft);
    font-size: 14px;
    font-weight: 600;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--acc);
    flex: none;
  }

  @media (max-width: 1100px) {
    .intro {
      margin-left: 0;
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 32px 28px;
    }

    .now {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0;
      padding-top: 24px;
    }

    h1 {
      font-size: 38px;
    }
  }

  @media (max-width: 560px) {
    .photo {
      height: 220px;
    }

    .intro {
      margin-top: -60px;
    }

    h1 {
      font-size: 32px;
    }

    .lede {
      font-size: 16px;
    }
  }
</style>
